# Réglages du serveur Ossuary. Copie ce fichier en « .env » (même dossier) et remplis-le.
# Le fichier .env contient des mots de passe : ne le partage pas (il est ignoré par git).

# --- Base de données ---------------------------------------------------------
# Adresse MongoDB. Laisse vide pour garder les comptes dans data/comptes.json (pratique pour développer).
# Exemple avec un utilisateur dédié au jeu, sur la même machine :
# MONGODB_URI=mongodb://ossuary:MOT_DE_PASSE@127.0.0.1:27017/ossuary?authSource=ossuary
MONGODB_URI=
# Nom de la base (collections « joueurs » et « clans »)
MONGODB_DB=ossuary

# --- Admins ------------------------------------------------------------------
# Pseudos toujours admin, séparés par des virgules (appliqué à chaque démarrage).
# Les autres admins se nomment depuis la page « Administration » du site.
ADMINS=

# --- Réseau ------------------------------------------------------------------
PORT=3000
# 0.0.0.0 = joignable depuis le réseau ; 127.0.0.1 = seulement depuis la machine (derrière nginx, en production)
HOST=0.0.0.0
# 1 si le jeu est derrière nginx : l'adresse IP des joueurs est lue dans X-Forwarded-For (limite d'essais de connexion)
TRUST_PROXY=0
